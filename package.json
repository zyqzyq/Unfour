{
  "name": "unfour",
  "private": true,
  "version": "0.9.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter @unfour/desktop dev",
    "build": "pnpm --filter @unfour/desktop build",
    "preview": "pnpm --filter @unfour/desktop preview",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:prepare-sidecars": "node scripts/prepare-tauri-sidecars.mjs",
    "check": "pnpm run check:version && pnpm run check:secrets && pnpm run build && pnpm run check:rust && pnpm run check:migrations && pnpm run check:large-files && pnpm run check:tokens",
    "check:version": "node scripts/sync-version.mjs --check",
    "check:rust": "cargo check --workspace",
    "check:rust:ssh": "cargo check -p unfour --features ssh-native",
    "check:large-files": "node scripts/check-large-files.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:tokens": "node scripts/check-shared-tokens.mjs",
    "check:secrets": "node scripts/audit-public-secrets.mjs",
    "prepare": "lefthook install",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rust": "cargo test --workspace",
    "test:release-env": "node --test scripts/release-environment.test.mjs scripts/release-channel.test.mjs scripts/release-contract.test.mjs scripts/release-candidate-contract.test.mjs scripts/check-update-order.test.mjs scripts/finalize-standard-release.test.mjs scripts/msix-contract.test.mjs",
    "msix:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/msix/build-msix.ps1 -PackageChannel Store -SignMode None",
    "msix:build:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/msix/build-msix.ps1 -PackageChannel Store -SignMode None -ConfigPath scripts/msix/msix.config.json",
    "msix:validate": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/msix/validate-msix.ps1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "@radix-ui/react-menu": "2.1.24",
      "@radix-ui/react-popper": "1.3.7"
    }
  }
}
